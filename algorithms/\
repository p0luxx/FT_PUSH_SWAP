#include "../push_swap.h"

void	normalize_stack(t_stack **stack);
void	push_chunks_to_b(t_stack **a, t_stack **b, t_count *c, t_bench *bench);
void	push_back_to_a(t_stack **a, t_stack **b, t_count *c, t_bench *bench);

int	ft_optimal_chunk_size(int n)
{
	if (n <= 20)
		return (n);
	if (n <= 50)
		return (8);
	if (n <= 100)
		return (14);
	if (n <= 200)
		return (22);
	if (n <= 500)
		return (38);
	return (45);
}

static int	init_count(t_count *count)
{
	count->ops = malloc(sizeof(char) * 2000000);
	if (!count->ops)
		return (0);
	count->ops[0] = '\0';
	count->op_count = 0;
	return (1);
}

void	ft_sort_medium(t_stack **a, t_bench *bench)
{
	t_stack	*b;
	t_count	count;

	if (!a || !(*a) || (*a)->size <= 1)
		return ;
	if (!init_count(&count))
		return ;
	if ((*a)->size <= 5)
		return (ft_sort_small(a, bench));
	b = ft_init_stack('b');
	if (!b)
		return (free(count.ops));
	normalize_stack(a);
	push_chunks_to_b(a, &b, &count, bench);
	push_back_to_a(a, &b, &count, bench);
	bench->total_ops = count.op_count;
	free(b);
	print_ops(count.ops, count.op_count);
	free(count.ops);
}
